          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Médico con esquema válido', () => {",
                  "  const schema = {type: 'object', required: ['id','nombre','documento','especialidad','disponible'], properties: {id:{type:'number'}, nombre:{type:'string'}, documento:{type:'string'}, especialidad:{type:'string'}, disponible:{type:'boolean'}}};",
                  "  pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "pm.collectionVariables.set('medicoId', pm.response.json().id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{medicoId}},\n  \"nombre\": \"Sofía Díaz\",\n  \"documento\": \"30123456\",\n  \"especialidad\": \"Pediatría\",\n  \"disponible\": true\n}"
